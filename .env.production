# Production Environment Variables for Render
# Copy these to Render dashboard for deployment

# Backend Settings
DEBUG=false
SECRET_KEY=your-secret-key-will-be-generated-by-render
ALGORITHM=HS256

# CORS Origins (update with your actual Render domain)
CORS_ORIGINS=https://finance-tracker-frontend.onrender.com,https://your-custom-domain.com

# Upload Directory (use /tmp for ephemeral storage)
UPLOAD_DIR=/tmp/uploads

# Database (if switching to PostgreSQL)
# DATABASE_URL=postgresql://user:password@host:port/database
# For now using SQLite which works out of box
