# .gitignore for Finance Tracker

# Virtual Environments
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class

# Node modules
node_modules/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependencies
dist/
build/
*.egg-info/

# Environment variables
.env
.env.local
.env.*.local

# IDE & Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.project
.pydevproject
.settings/
*.sublime-project
*.sublime-workspace

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp

# Database
*.db
*.sqlite
*.sqlite3
database.db

# Uploads
uploads/
!uploads/.gitkeep

# ML Models
ml_models/*.pkl
ml_models/*.joblib

# Build outputs
frontend/build/
frontend/.cache/

# Docker
.dockerignore
docker-compose.override.yml

# OS specific
.DS_Store
Thumbs.db
.directory

# Misc
.cache/
.python-version
*.pid
dist/
