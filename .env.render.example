# Render deployment example env (do NOT commit secrets)
# Replace values in Render Dashboard environment settings

# Application
DEBUG=false
SECRET_KEY=change-this-in-render-dashboard
ALGORITHM=HS256

# Postgres connection (Render-provided) - keep this set to use managed Postgres
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional - if Postgres is temporarily unavailable, the app will fall back to a local SQLite file automatically.
# MAINTENANCE_MODE=true  # Set to true to show a maintenance page

# CORS - comma separated or JSON list depending on your config
CORS_ORIGINS=https://your-frontend.onrender.com

# Frontend URL for production build
REACT_APP_API_URL=https://your-backend.onrender.com/api
